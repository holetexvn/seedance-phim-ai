# Get your Seedance 2.5 API Key on BytePlus: https://bit.ly/3Vqzy7X
# Copy file nay vao ark\.env roi dan API key vao dong duoi
BYTEPLUS_MODELARK_API_KEY=

# ----- Phan duoi da cau hinh san, khong can sua -----
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDREAM_DEFAULT_MODEL=dola-seedream-5-0-pro-260628
SEEDANCE_DEFAULT_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_MODEL_FAMILY=seedance_2_5
SEEDANCE_MODEL_BINDINGS=[{"model_id":"dreamina-seedance-2-5-260628","family":"seedance_2_5"}]
MCP_TRANSPORT=stdio
MCP_AUTH_MODE=local
ARTIFACT_BACKEND=filesystem
ARTIFACT_DIR=C:\DUONG\DAN\TOI\seedance-lumina\output\.artifacts
OUTPUT_ROOTS=C:\DUONG\DAN\TOI\seedance-lumina\output
STATE_BACKEND=sqlite
PROVIDER_MAX_CONCURRENCY=5
PRINCIPAL_MAX_CONCURRENCY=3
DAILY_BUDGET_USD=0
ARK_LOG_LEVEL=INFO
